# mk/area-fw.mk: SurfBoot, the diagnostics, the card tools and their host tests (track fw).
#
#   make build-rom   build/fw/surfboot.{elf,bin,mem} (the boot ROM), build/fw/bramdiag.{elf,bin,mem}
#                    (the milestone 3 BRAM diagnostics, an alternative ROM), build/fw/ddrdiag.elf and
#                    build/fw/DDRDIAG.BIN (the DDR diagnostic as a SURFOS.BIN package); every ELF goes
#                    through tools/isa-audit.py
#   make test-fw     host tests: the tools, the SD/FAT/image code against card images, and the ROM
#                    images running in the firmware emulator (docs/FIRMWARE.md)

FW          := $(BUILD)/fw
FW_GEN      := $(FW)/gen
FW_OBJ      := $(FW)/obj
FW_INC      := -Ifirmware/include -Ifirmware/common -Ifirmware/surfboot -Ifirmware/diagnostics \
               -Ifirmware/common/libc
# The boot ROM is at address 0, so address 0 is valid memory here: no null-pointer assumptions.
FW_CFLAGS   := $(RV_CFLAGS) -Os -msave-restore -std=gnu11 -mstrict-align -fno-tree-loop-distribute-patterns \
               -fno-delete-null-pointer-checks --param=min-pagesize=0 \
               -fno-asynchronous-unwind-tables -fno-unwind-tables -Werror $(FW_INC) -I$(FW_GEN) -MMD -MP
FW_LDFLAGS  := $(RV_LDFLAGS) -Lfirmware/ld -Lfirmware/common -Wl,--no-warn-rwx-segments
ISA_AUDIT   := $(PYTHON) tools/isa-audit.py
BIN2MEM     := $(PYTHON) tools/bin2mem.py
SURFIMG     := $(PYTHON) tools/surfimg.py

.PHONY: build-fw-rom test-fw-host test-fw-unit test-fw-scenarios test-fw-emu FORCE
build-rom: build-fw-rom
test-fw: test-fw-host
check: build-rom

# ---- build identity: regenerated only when it changes, so objects rebuild exactly then ----
$(FW_GEN)/fw_build.h: FORCE
	@mkdir -p $(dir $@)
	@printf '/* generated by mk/area-fw.mk */\n#define FW_BUILD_ID 0x%sU\n#define FW_BUILD_DIRTY %s\n' \
	  '$(BUILD_ID_HEX)' '$(SURFCPU_BUILD_DIRTY)' > $@.new
	@if cmp -s $@.new $@; then rm -f $@.new; else mv $@.new $@; fi

# ---- RV32 objects ----
FW_COMMON     := trap.S setjmp.S trap.c uart.c video.c console.c timer.c led.c string.c fmt.c crc32.c
FW_COMMON_OBJ := $(patsubst %,$(FW_OBJ)/common/%.o,$(FW_COMMON))

$(FW_OBJ)/%.c.o: firmware/%.c | $(FW_GEN)/fw_build.h
	@mkdir -p $(dir $@)
	$(Q)$(RV_CC) $(FW_CFLAGS) -c $< -o $@

$(FW_OBJ)/%.S.o: firmware/%.S
	@mkdir -p $(dir $@)
	$(Q)$(RV_CC) $(FW_CFLAGS) -c $< -o $@

$(FW_OBJ)/common/start_rom.o: firmware/common/start.S
	@mkdir -p $(dir $@)
	$(Q)$(RV_CC) $(FW_CFLAGS) -c $< -o $@

$(FW_OBJ)/common/start_ram.o: firmware/common/start.S
	@mkdir -p $(dir $@)
	$(Q)$(RV_CC) $(FW_CFLAGS) -DFW_RAM_IMAGE -c $< -o $@

FW_LD_DEPS := firmware/common/rom.ld firmware/common/ram.ld firmware/ld/surfcpu_soc.ld

# ---- SurfBoot ----
SURFBOOT_SRC := main.c boot.c sd.c fat32.c image.c monitor.c sberr.c port_surf.c handoff.S
SURFBOOT_OBJ := $(FW_OBJ)/common/start_rom.o $(patsubst %,$(FW_OBJ)/surfboot/%.o,$(SURFBOOT_SRC)) \
                $(FW_COMMON_OBJ)

$(FW)/surfboot.elf: $(SURFBOOT_OBJ) firmware/surfboot/surfboot.ld $(FW_LD_DEPS)
	$(Q)$(RV_CC) $(FW_LDFLAGS) -T firmware/surfboot/surfboot.ld -Wl,-Map,$(FW)/surfboot.map \
	  $(SURFBOOT_OBJ) $(RV_LIBGCC) -o $@.tmp
	$(Q)$(ISA_AUDIT) $@.tmp
	$(Q)mv $@.tmp $@

$(FW)/%.bin: $(FW)/%.elf
	$(Q)$(RV_OBJCOPY) -O binary $< $@

$(FW)/%.mem: $(FW)/%.bin
	$(Q)$(BIN2MEM) $< $@

.SECONDARY: $(FW)/surfboot.bin $(FW)/bramdiag.bin
build-fw-rom: $(FW)/surfboot.mem $(FW)/surfboot.bin $(FW)/bramdiag.mem $(FW)/bramdiag.bin $(FW)/DDRDIAG.BIN
	@$(RV_SIZE) $(FW)/surfboot.elf | tail -n 1 | awk '{ printf "build-rom: surfboot.elf text %u data %u bss %u: ROM %u of 65536 bytes (%.1f%%)\n", $$1, $$2, $$3, $$1 + $$2, ($$1 + $$2) * 100 / 65536 }'
	@$(RV_SIZE) $(FW)/bramdiag.elf | tail -n 1 | awk '{ printf "build-rom: bramdiag.elf ROM %u of 65536 bytes (%.1f%%)\n", $$1 + $$2, ($$1 + $$2) * 100 / 65536 }'

# ---- the diagnostics: the BRAM program (a ROM image) and the DDR diagnostic (a SURFOS.BIN) ----
DIAG_SRC     := diagnostics/report.c diagnostics/cputest.c diagnostics/ddrtest.c diagnostics/probes.S
BRAMDIAG_OBJ := $(FW_OBJ)/common/start_rom.o $(patsubst %,$(FW_OBJ)/%.o,diagnostics/bramdiag.c $(DIAG_SRC)) \
                $(FW_COMMON_OBJ)
DDRDIAG_OBJ  := $(FW_OBJ)/common/start_ram.o $(patsubst %,$(FW_OBJ)/%.o,diagnostics/ddrdiag.c $(DIAG_SRC)) \
                $(FW_COMMON_OBJ)

$(FW)/bramdiag.elf: $(BRAMDIAG_OBJ) firmware/diagnostics/bramdiag.ld $(FW_LD_DEPS)
	$(Q)$(RV_CC) $(FW_LDFLAGS) -T firmware/diagnostics/bramdiag.ld -Wl,-Map,$(FW)/bramdiag.map \
	  $(BRAMDIAG_OBJ) $(RV_LIBGCC) -o $@.tmp
	$(Q)$(ISA_AUDIT) $@.tmp
	$(Q)mv $@.tmp $@

$(FW)/ddrdiag.elf: $(DDRDIAG_OBJ) $(FW_LD_DEPS)
	$(Q)$(RV_CC) $(FW_LDFLAGS) -T firmware/common/ram.ld -Wl,-Map,$(FW)/ddrdiag.map \
	  $(DDRDIAG_OBJ) $(RV_LIBGCC) -o $@.tmp
	$(Q)$(ISA_AUDIT) $@.tmp
	$(Q)mv $@.tmp $@

$(FW)/DDRDIAG.BIN: $(FW)/ddrdiag.elf tools/surfimg.py
	$(Q)$(SURFIMG) pack --elf $< -o $@ --payload-out $(FW)/ddrdiag.payload.bin --name DDRdiag \
	  --version 1.0.0 --build-id $(BUILD_ID_HEX) --no-audit

# ---- test kernel for the handoff (a SURFOS.BIN) ----
HELLO_SRC := tests/hello/hello_start.S tests/hello/hello.c common/fmt.c common/crc32.c common/string.c
HELLO_OBJ := $(patsubst %,$(FW_OBJ)/%.o,$(HELLO_SRC))

$(FW)/hello.elf: $(HELLO_OBJ) $(FW_LD_DEPS)
	$(Q)$(RV_CC) $(FW_LDFLAGS) -T firmware/common/ram.ld -Wl,-Map,$(FW)/hello.map $(HELLO_OBJ) $(RV_LIBGCC) -o $@.tmp
	$(Q)$(ISA_AUDIT) --quiet $@.tmp
	$(Q)mv $@.tmp $@

$(FW)/HELLO.BIN: $(FW)/hello.elf tools/surfimg.py
	$(Q)$(SURFIMG) pack --elf $< -o $@ --name Hello --version 1.0.0 --build-id $(BUILD_ID_HEX) --no-audit

# ---- the firmware emulator ----
$(FW)/host/surfemu: firmware/tests/surfemu.c firmware/tests/sdcard_sim.c firmware/tests/sdcard_sim.h \
                    firmware/include/surfcpu/soc.h
	@mkdir -p $(dir $@)
	$(Q)$(FW_HOST_CC) -std=gnu11 -O2 -g -Wall -Wextra -Werror -Ifirmware/include -Ifirmware/tests \
	  firmware/tests/surfemu.c firmware/tests/sdcard_sim.c -o $@

# ---- host build of the portable code, with the sanitizers ----
FW_HOST_CC     ?= gcc
FW_HOST_CFLAGS := -std=gnu11 -O1 -g -Wall -Wextra -Werror -DSURF_HOST=1 -fno-omit-frame-pointer \
                  -fsanitize=address,undefined -fno-sanitize-recover=all \
                  -Ifirmware/include -Ifirmware/common -Ifirmware/surfboot -Ifirmware/tests
FW_PORTABLE    := firmware/surfboot/sd.c firmware/surfboot/fat32.c firmware/surfboot/image.c \
                  firmware/surfboot/boot.c firmware/surfboot/monitor.c firmware/surfboot/sberr.c \
                  firmware/common/fmt.c firmware/common/crc32.c
FW_HOST_SRC    := $(FW_PORTABLE) firmware/tests/sdcard_sim.c firmware/tests/port_host.c firmware/tests/fwtest.c
FW_HOST_HDR    := $(wildcard firmware/surfboot/*.h firmware/common/*.h firmware/tests/*.h firmware/include/surfcpu/*.h)

$(FW)/host/fwtest: $(FW_HOST_SRC) $(FW_HOST_HDR)
	@mkdir -p $(dir $@)
	$(Q)$(FW_HOST_CC) $(FW_HOST_CFLAGS) $(FW_HOST_SRC) -o $@

test-fw-unit: $(FW)/host/fwtest
	$(Q)ASAN_OPTIONS=detect_leaks=1 $(FW)/host/fwtest unit

test-fw-scenarios: $(FW)/host/fwtest
	$(Q)$(PYTHON) firmware/tests/run_tests.py --fwtest $(FW)/host/fwtest $(if $(FW_JOBS),--jobs $(FW_JOBS))

test-fw-emu: $(FW)/host/surfemu $(FW)/surfboot.mem $(FW)/bramdiag.mem $(FW)/DDRDIAG.BIN $(FW)/HELLO.BIN
	$(Q)$(PYTHON) firmware/tests/run_emu.py $(if $(FW_JOBS),--jobs $(FW_JOBS))

test-fw-host: test-fw-unit test-fw-scenarios test-fw-emu

-include $(shell find $(FW_OBJ) -name '*.d' 2>/dev/null)

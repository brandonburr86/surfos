localparam [31:0] SURF_VIDEO_STATUS = 32'h0000_0004;  // w1c: Frame state.
localparam integer SURF_VIDEO_STATUS_VBLANK_LSB = 0;  // in vertical blanking now
localparam integer SURF_VIDEO_STATUS_VBLANK_WIDTH = 1;
localparam [31:0] SURF_VIDEO_STATUS_VBLANK_MASK = 32'h0000_0001;  // in place
localparam integer SURF_VIDEO_STATUS_VBLANK_EV_LSB = 1;  // sticky: a vertical blanking interval began (interrupt source when IE.VBLANK)
localparam integer SURF_VIDEO_STATUS_VBLANK_EV_WIDTH = 1;
localparam [31:0] SURF_VIDEO_STATUS_VBLANK_EV_MASK = 32'h0000_0002;  // in place
localparam integer SURF_VIDEO_STATUS_FRAME_LSB = 16;  // frame counter (wraps)
localparam integer SURF_VIDEO_STATUS_FRAME_WIDTH = 16;
localparam [31:0] SURF_VIDEO_STATUS_FRAME_MASK = 32'hFFFF_0000;  // in place
localparam [31:0] SURF_VIDEO_CURSOR = 32'h0000_0008;  // rw: Cursor position on the screen (display coordinates, after SCROLL).
localparam integer SURF_VIDEO_CURSOR_COL_LSB = 0;  // column 0..79
localparam integer SURF_VIDEO_CURSOR_COL_WIDTH = 7;
localparam [31:0] SURF_VIDEO_CURSOR_COL_MASK = 32'h0000_007F;  // in place
localparam integer SURF_VIDEO_CURSOR_ROW_LSB = 8;  // row 0..29
localparam integer SURF_VIDEO_CURSOR_ROW_WIDTH = 5;
localparam [31:0] SURF_VIDEO_CURSOR_ROW_MASK = 32'h0000_1F00;  // in place
localparam [31:0] SURF_VIDEO_SCROLL = 32'h0000_000C;  // rw: First text row shown at the top of the screen.
localparam integer SURF_VIDEO_SCROLL_ROW_LSB = 0;  // 0..29 (values 30..31 act as 0)
localparam integer SURF_VIDEO_SCROLL_ROW_WIDTH = 5;
localparam [31:0] SURF_VIDEO_SCROLL_ROW_MASK = 32'h0000_001F;  // in place
localparam [31:0] SURF_VIDEO_IE = 32'h0000_0010;  // rw: Interrupt enable.
localparam integer SURF_VIDEO_IE_VBLANK_LSB = 0;  // interrupt while STATUS.VBLANK_EV
localparam integer SURF_VIDEO_IE_VBLANK_WIDTH = 1;
localparam [31:0] SURF_VIDEO_IE_VBLANK_MASK = 32'h0000_0001;  // in place
localparam [31:0] SURF_VIDEO_INFO = 32'h0000_0014;  // ro: Text geometry: 80 columns, 30 rows, 8x16 glyphs.
localparam integer SURF_VIDEO_INFO_COLS_LSB = 0;  // 80
localparam integer SURF_VIDEO_INFO_COLS_WIDTH = 8;
localparam [31:0] SURF_VIDEO_INFO_COLS_MASK = 32'h0000_00FF;  // in place
localparam integer SURF_VIDEO_INFO_ROWS_LSB = 8;  // 30
localparam integer SURF_VIDEO_INFO_ROWS_WIDTH = 8;
localparam [31:0] SURF_VIDEO_INFO_ROWS_MASK = 32'h0000_FF00;  // in place
localparam integer SURF_VIDEO_INFO_GLYPH_W_LSB = 16;  // 8
localparam integer SURF_VIDEO_INFO_GLYPH_W_WIDTH = 4;
localparam [31:0] SURF_VIDEO_INFO_GLYPH_W_MASK = 32'h000F_0000;  // in place
localparam integer SURF_VIDEO_INFO_GLYPH_H_LSB = 24;  // 16
localparam integer SURF_VIDEO_INFO_GLYPH_H_WIDTH = 5;
localparam [31:0] SURF_VIDEO_INFO_GLYPH_H_MASK = 32'h1F00_0000;  // in place
localparam [31:0] SURF_VIDEO_PIXCLK = 32'h0000_0018;  // ro: Actual pixel clock in Hz (clocks.pix_hz).
localparam [31:0] SURF_VIDEO_PALETTE = 32'h0000_0040;  // rw: Palette entry n at 0x40 + 4n: RGB444 as bits 11:8 red, 7:4 green, 3:0 blue. Reset: the 16 CGA colors.
localparam integer SURF_VIDEO_PALETTE_COUNT = 16;  // consecutive words
localparam integer SURF_VIDEO_PALETTE_B_LSB = 0;  // blue
localparam integer SURF_VIDEO_PALETTE_B_WIDTH = 4;
localparam [31:0] SURF_VIDEO_PALETTE_B_MASK = 32'h0000_000F;  // in place
localparam integer SURF_VIDEO_PALETTE_G_LSB = 4;  // green
localparam integer SURF_VIDEO_PALETTE_G_WIDTH = 4;
localparam [31:0] SURF_VIDEO_PALETTE_G_MASK = 32'h0000_00F0;  // in place
localparam integer SURF_VIDEO_PALETTE_R_LSB = 8;  // red
localparam integer SURF_VIDEO_PALETTE_R_WIDTH = 4;
localparam [31:0] SURF_VIDEO_PALETTE_R_MASK = 32'h0000_0F00;  // in place
localparam [31:0] SURF_SYSINFO_MAGIC = 32'h0000_0000;  // ro: 0x46525553, the bytes "SURF" in memory order.
localparam [31:0] SURF_SYSINFO_SOC_VERSION = 32'h0000_0004;  // ro: soc.soc_version as major << 16 | minor << 8 | patch.
localparam [31:0] SURF_SYSINFO_MAP_VERSION = 32'h0000_0008;  // ro: soc.map_version: which version of this memory map the hardware implements.
localparam [31:0] SURF_SYSINFO_BOARD_ID = 32'h0000_000C;  // ro: A value from [boards].
localparam [31:0] SURF_SYSINFO_SYS_HZ = 32'h0000_0010;  // ro: sys_clk frequency in Hz.
localparam [31:0] SURF_SYSINFO_BUILD_ID = 32'h0000_0014;  // ro: First 8 hex digits of the source commit the bitstream was built from.
localparam [31:0] SURF_SYSINFO_BUILD_FLAGS = 32'h0000_0018;  // ro: Build properties.
localparam integer SURF_SYSINFO_BUILD_FLAGS_DIRTY_LSB = 0;  // the source tree had uncommitted changes
localparam integer SURF_SYSINFO_BUILD_FLAGS_DIRTY_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_BUILD_FLAGS_DIRTY_MASK = 32'h0000_0001;  // in place
localparam integer SURF_SYSINFO_BUILD_FLAGS_SIM_LSB = 1;  // this is a simulation, not a bitstream
localparam integer SURF_SYSINFO_BUILD_FLAGS_SIM_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_BUILD_FLAGS_SIM_MASK = 32'h0000_0002;  // in place
localparam [31:0] SURF_SYSINFO_FEATURES = 32'h0000_001C;  // ro: Which blocks were built in.
localparam integer SURF_SYSINFO_FEATURES_UART_LSB = 0;
localparam integer SURF_SYSINFO_FEATURES_UART_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_UART_MASK = 32'h0000_0001;  // in place
localparam integer SURF_SYSINFO_FEATURES_TIMER_LSB = 1;
localparam integer SURF_SYSINFO_FEATURES_TIMER_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_TIMER_MASK = 32'h0000_0002;  // in place
localparam integer SURF_SYSINFO_FEATURES_IRQ_LSB = 2;
localparam integer SURF_SYSINFO_FEATURES_IRQ_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_IRQ_MASK = 32'h0000_0004;  // in place
localparam integer SURF_SYSINFO_FEATURES_GPIO_LSB = 3;
localparam integer SURF_SYSINFO_FEATURES_GPIO_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_GPIO_MASK = 32'h0000_0008;  // in place
localparam integer SURF_SYSINFO_FEATURES_SPI_LSB = 4;
localparam integer SURF_SYSINFO_FEATURES_SPI_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_SPI_MASK = 32'h0000_0010;  // in place
localparam integer SURF_SYSINFO_FEATURES_PS2_LSB = 5;
localparam integer SURF_SYSINFO_FEATURES_PS2_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_PS2_MASK = 32'h0000_0020;  // in place
localparam integer SURF_SYSINFO_FEATURES_VIDEO_LSB = 6;
localparam integer SURF_SYSINFO_FEATURES_VIDEO_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_VIDEO_MASK = 32'h0000_0040;  // in place
localparam integer SURF_SYSINFO_FEATURES_DDR_LSB = 7;
localparam integer SURF_SYSINFO_FEATURES_DDR_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_FEATURES_DDR_MASK = 32'h0000_0080;  // in place
localparam [31:0] SURF_SYSINFO_DDR_STATUS = 32'h0000_0020;  // ro: DDR controller state. The DDR window answers with errors until CALIB_DONE.
localparam integer SURF_SYSINFO_DDR_STATUS_CALIB_DONE_LSB = 0;  // calibration succeeded; DDR is usable
localparam integer SURF_SYSINFO_DDR_STATUS_CALIB_DONE_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_DDR_STATUS_CALIB_DONE_MASK = 32'h0000_0001;  // in place
localparam integer SURF_SYSINFO_DDR_STATUS_CALIB_FAIL_LSB = 1;  // calibration did not finish within its time limit
localparam integer SURF_SYSINFO_DDR_STATUS_CALIB_FAIL_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_DDR_STATUS_CALIB_FAIL_MASK = 32'h0000_0002;  // in place
localparam integer SURF_SYSINFO_DDR_STATUS_PRESENT_LSB = 2;  // a DDR controller is built in
localparam integer SURF_SYSINFO_DDR_STATUS_PRESENT_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_DDR_STATUS_PRESENT_MASK = 32'h0000_0004;  // in place
localparam integer SURF_SYSINFO_DDR_STATUS_TIMEOUT_LSB = 3;  // sticky until reset: a DDR access was abandoned by the bridge's watchdog
localparam integer SURF_SYSINFO_DDR_STATUS_TIMEOUT_WIDTH = 1;
localparam [31:0] SURF_SYSINFO_DDR_STATUS_TIMEOUT_MASK = 32'h0000_0008;  // in place
localparam [31:0] SURF_SYSINFO_DDR_SIZE = 32'h0000_0024;  // ro: Bytes of DDR behind the window (0 when not present).
localparam [31:0] SURF_SYSINFO_PIX_HZ = 32'h0000_0028;  // ro: Pixel clock in Hz (0 without video).
localparam [31:0] SURF_SYSINFO_SCRATCH = 32'h0000_002C;  // rw: Free read/write word for bus tests (reset 0).
localparam [31:0] SURF_SYSINFO_BUILD_TIME = 32'h0000_0030;  // ro: Build time, seconds since 1970-01-01 UTC (0 if unknown).
localparam [31:0] SURF_IMAGE_MAGIC = 32'h474D_4953;  // boot ABI
localparam [31:0] SURF_IMAGE_HEADER_VERSION = 32'h0000_0001;  // boot ABI
localparam [31:0] SURF_IMAGE_HEADER_SIZE = 32'h0000_0040;  // boot ABI
localparam [31:0] SURF_BOOTINFO_MAGIC = 32'h4946_5253;  // boot ABI
localparam [31:0] SURF_BOOTINFO_VERSION = 32'h0000_0001;  // boot ABI
localparam [31:0] SURF_PLATFORM_ABI = 32'h0000_0001;  // boot ABI
localparam [31:0] SURF_ISA_I = 32'h0000_0001;  // boot ABI
localparam [31:0] SURF_ISA_M = 32'h0000_0002;  // boot ABI
localparam [31:0] SURF_ISA_ZICSR = 32'h0000_0004;  // boot ABI
localparam [31:0] SURF_ISA_ZIFENCEI = 32'h0000_0008;  // boot ABI
localparam [31:0] SURF_BOOT_DEVICE_SD = 32'h0000_0001;  // boot ABI
/* verilator lint_on UNUSEDPARAM */

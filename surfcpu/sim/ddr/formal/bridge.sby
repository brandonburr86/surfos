# SurfCPU: proofs of surf_ddr_bridge's SurfBus obligations (bridge_formal.sv)
# File: bridge.sby Date: 10/15/26 (SurfCPU)
#   run from surfcpu/: sby -f -d build/ddr/formal_bridge_<task> sim/ddr/formal/bridge.sby <task>
#   prove  responses only for waiting requests and never in reset, the watchdog bound,
#          calib_done/calib_fail exclusive, timeout sticky (seconds; make prove-ddr)
#   stale  the same plus "no stale answer delivered", unbounded (much slower; make prove-ddr-stale)
#   stalebmc  that property checked to 40 steps (bounded; make prove-ddr)
#   cover  a real answer from the controller side is reachable
[tasks]
prove
stale
stalebmc
cover

[options]
prove: mode prove
stale: mode prove
stalebmc: mode bmc
stalebmc: depth 40
prove: aigsmt z3
stale: aigsmt z3
cover: mode cover
cover: depth 60
multiclock on

[engines]
prove: abc pdr
stale: abc pdr
stalebmc: smtbmc z3
cover: smtbmc z3

[script]
read -formal -Irtl/generated surf_sync.v surf_ddr_mailbox.v surf_ddr_bridge.v
prove: read -formal bridge_formal.sv
cover: read -formal bridge_formal.sv
stale: read -formal -DSTALE_CHECK bridge_formal.sv
stalebmc: read -formal -DSTALE_CHECK bridge_formal.sv
prep -top bridge_formal
# bit-blast, so the data bits no assertion depends on (addresses, write data, read data) go
flatten
techmap
opt -fast
opt_clean -purge

[files]
rtl/lib/surf_sync.v
rtl/soc/ddr/surf_ddr_mailbox.v
rtl/soc/ddr/surf_ddr_bridge.v
rtl/generated/surfcpu_soc.vh
sim/ddr/formal/bridge_formal.sv

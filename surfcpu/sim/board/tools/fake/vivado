#!/bin/sh
# Fake vivado for the board track's wrapper tests: runs the -source script with -tclargs in
# Yosys's Tcl interpreter with sim/board/tools/vivado_stub.tcl's stand-in Vivado commands.
echo "vivado $*" >> "$FAKE_LOG"
src=
targs=
log=vivado.log
while [ $# -gt 0 ]; do
    case "$1" in
        -source)  src=$2; shift 2 ;;
        -tclargs) targs=$2; shift 2 ;;
        -log)     log=$2; shift 2 ;;
        *)        shift ;;
    esac
done
mkdir -p "$(dirname "$log")" out
FAKE_SOURCE=$src FAKE_TCLARGS=$targs FAKE_CALLS=$(pwd)/out/calls.txt \
    yosys -q -c "$FAKE_STUB" > "$log" 2>&1

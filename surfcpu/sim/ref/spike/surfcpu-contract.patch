+bool cause_csr_t::unlogged_write(const reg_t val) noexcept {
+  // SurfCPU (docs/ISA.md section 2): mcause keeps bit 31 and bits 4:0.
+  if (address == CSR_MCAUSE)
+    return basic_csr_t::unlogged_write(val & (((reg_t)1 << (proc->get_xlen() - 1)) | 0x1f));
+  return basic_csr_t::unlogged_write(val);
+}
+

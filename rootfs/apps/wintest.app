# wintest, the window calls' test program (user/bin/wintest.c): only Files uses this entry, for the
# desktop's screen test (tools/gui_apps_desk.py). A file of the type wintest opens in it, which says
# the file's path in its title; it is in neither Apps > Programs nor on the desktop.
program = wintest
title = Window test
types = wintest
apps = no
desktop = no

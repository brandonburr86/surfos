# Image Viewer: pictures, shown (user/wview/, track img). The desktop has it as an application of its
# own (shell/guiview.c): Apps > Image Viewer and its tile are the desktop's, and a double-click on a
# picture keeps the desktop's rule for pictures, which starts this program at the Image Viewer's place.
# Its types are named under open-with, so that File > Open with offers it for every picture it reads.
program = wview
title = Image Viewer
open-with = bmp png gif jpg jpeg
icon = ................
icon = .KKKKKKKKKKKKKK.
icon = .KBBBBBBBBBBBBK.
icon = .KBBBBBBBBBSSBK.
icon = .KBBBBBBBBBSSBK.
icon = .KBBBBBBBBBBBBK.
icon = .KBBBBBGBBBBBBK.
icon = .KBBBBGGGBBBBBK.
icon = .KBBBGGGGGBBGBK.
icon = .KBBGGGGGGGGGGK.
icon = .KBGGGGGGGGGGGK.
icon = .KGGGGGGGGGGGGK.
icon = .KFFFFFFFFFFFFK.
icon = .KTTTTTTTTTTTTK.
icon = .KKKKKKKKKKKKKK.
icon = ................

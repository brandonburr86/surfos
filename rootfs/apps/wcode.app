# Code Editor: text and code, in tabs (user/wcode/; the desktop applications, track code). Files opens the types below
# in it; a plain .txt stays Notepad's, and Open with offers the Code Editor for it and the others named in open-with.
# The icon: a page of code, its lines in the colours the editor gives keywords, strings and comments.
program = wcode
title = Code Editor
types = c h asm nasm inc s py sh bash mk mak md markdown json =Makefile =GNUmakefile
open-with = txt log conf cfg ini
apps = yes
desktop = yes
icon = ................
icon = .KKKKKKKKKKKKKK.
icon = .KTTTTTTTTTTTTK.
icon = .KKKKKKKKKKKKKK.
icon = .KPPPPPPPPPPPPK.
icon = .KPBBBPKKKPPPPK.
icon = .KPPPPGGGGGGPPK.
icon = .KPPPPCCPKKPPPK.
icon = .KPPPPPPPPPPPPK.
icon = .KPBBPKKKKPPPPK.
icon = .KPPPPGGGGPPPPK.
icon = .KPPPPPPPPPPPPK.
icon = .KPMMMMMMMMPPPK.
icon = .KPPPPPPPPPPPPK.
icon = .KKKKKKKKKKKKKK.
icon = ................

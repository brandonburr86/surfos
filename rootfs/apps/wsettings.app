# Settings (user/wsettings/, the desktop applications' track settings): the Wi-Fi, the network,
# the desktop's theme and pointer, the system's settings on the stick, and what SurfOS runs on.
# It opens no files. Its icon: three sliders on a panel, drawn for SurfOS.
program = wsettings
title = Settings
apps = yes
desktop = yes
icon = ................

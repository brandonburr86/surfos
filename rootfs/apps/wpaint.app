# Paint (user/wpaint/): pictures drawn, opened and saved. It edits pictures, so they are in open-with, not types:
# a double-click in Files keeps showing a picture, and Open with offers Paint for each kind it opens.
program = wpaint
title = Paint
open-with = bmp png gif jpg jpeg
apps = yes
desktop = yes
icon = ................
icon = .KKKKKKKKKKKK...
icon = .KPPPPPPPPPPK...
icon = .KPCCPPPPPPPK...
icon = .KPCCPPPSSPPK...
icon = .KPPPPPPSSPPK...
icon = .KPPPPPPPPPPK.NN
icon = .KPBBPPPPPPPKNNN
icon = .KPBBPPPPPPNNNN.
icon = .KPPPPPPPPNNNN..
icon = .KPPPPPPPNNNN...
icon = .KPPPPPPTTNN....
icon = .KPPPPPTTTT.....
icon = .KKKKKKTTTK.....
icon = ................
icon = ................
